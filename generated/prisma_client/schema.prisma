datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  output        = "../generated/prisma_client"
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

// User model representing customers
model User {
  id             String          @id @default(cuid())
  name           String?
  email          String          @unique
  emailVerified  DateTime?
  mobileNumber   String?
  image          String?
  password       String?
  role           Role            @default(USER)
  accounts       Account[]
  refreshToken   String?
  orders         Order[]
  reviews        Review[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  cartItem       CartItem[]
  emails         Email[]
  resetTokens    ResetToken[]
  repairBookings RepairBooking[]
  address        Address[]
}

// Account model for user's authentication accounts
model Account {
  provider          String
  providerAccountId String
  userId            String  @unique
  type              String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

// VerificationToken model
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model ResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
  @@index([expires])
}

model Address {
  id             String  @id @default(cuid())
  street         String
  city           String
  county         String
  postalCode     String
  pickupLocation String?
  country        String  @default("Kenya")
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repairBooking RepairBooking[]
}

// Category model
model Category {
  id          String    @id @default(cuid())
  name        String
  description String?
  products    Product[]
}

model ProductTags {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

// Tag model
model Tag {
  id          String        @id @default(cuid())
  name        String
  description String?
  products    ProductTags[]
}

// Product model
model Product {
  id          String        @id @default(cuid())
  name        String
  description String
  slug        String        @unique @default("")
  price       Int
  stock       Int
  images      String[] // URLs of product images
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String?
  tags        ProductTags[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  reviews     Review[]
  orderItem   OrderItem[]
  cartItem    CartItem[]

  @@index([slug])
}

model CartItem {
  userId    String
  productId String
  quantity  Int

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, productId])
}

enum OrderStatus {
  SCHEDULED
  FAILED
  PARTIALLY_FULLFILLED
  AWAITING_PAYMENT
  BACK_ORDERED
  ON_HOLD
  REFUNDED
  RETURNED
  DELIVERED
  SHIPPED
  CANCELLED
  COMPLETED
  PROCESSING
  PENDING
}

// Order model
model Order {
  id         String      @id @default(cuid())
  createdAt  DateTime    @default(now())
  status     OrderStatus @default(PENDING)
  totalPrice Float
  user       User        @relation(fields: [userId], references: [id])
  userId     String
  items      OrderItem[]
  payment    Payment?
  Email      Email[]
}

// OrderItem model representing items in an order
model OrderItem {
  id        String  @id @default(cuid())
  quantity  Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   String
}

enum PaymentStatus {
  PENDING
  CHARGEBACK
  VOIDED
  CAPTURED
  AUTHORIZED
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  COMPLETED
}

// Payment model
model Payment {
  id                String        @id @default(cuid())
  amount            Float
  currency          String        @default("ksh")
  status            PaymentStatus @default(PENDING)
  checkoutRequestId String?       @unique
  failureReason     String?
  orderId           String?       @unique
  order             Order?        @relation(fields: [orderId], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

// Email model for tracking sent emails
model Email {
  id          String      @id @default(cuid())
  to          String
  subject     String
  template    String? // Template name used (optional)
  content     String
  status      EmailStatus @default(PENDING)
  retryCount  Int         @default(0)
  error       String?
  userId      String? // User who triggered the email
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId     String? // reference to related order
  order       Order?      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  resendId    String?
  scheduledAt DateTime? // for scheduled emails
  sentAt      DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([to])
  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@index([orderId])
}

// Email status enum
enum EmailStatus {
  PENDING
  SENT
  FAILED
  RETRYING
  BOUNCED
  DELIVERED
  OPENED
  CLICKED
}

enum RepairStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  WAITING_FOR_MATERIALS
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum ClothingType {
  SHIRT
  TROUSERS
  DRESS
  SKIRT
  JACKET
  COAT
  SUIT
  JEANS
  SWEATER
  OTHER
}

enum RepairType {
  ALTERATION
  HEM_MENDING
  ZIPPER_REPLACEMENT
  BUTTON_REPLACEMENT
  PATCH_REPAIR
  SEAM_MENDING
  SIZE_ADJUSTMENT
  FABRIC_PATCHING
  TAILORING
  OTHER
}

enum FabricType {
  COTTON
  LINEN
  SILK
  WOOL
  POLYESTER
  DENIM
  KNIT
  LEATHER
  SUEDE
  OTHER
}

model RepairBooking {
  id String @id @default(cuid())

  // Customer Information
  user          User   @relation(fields: [userId], references: [id])
  userId        String
  customerName  String
  customerEmail String
  customerPhone String

  // Clothing Information
  clothingType ClothingType
  clothingItem String // "work shirt", "wedding dress"
  brand        String?
  fabricType   FabricType
  color        String?
  size         String? // e.g "M", "42", "10-12"

  // Repair Details
  repairTypes         RepairType[] // Multiple types can be selected
  description         String // Detailed description of what needs repair
  images              String[] // Photos of the clothing item
  specialInstructions String? // Any special requests

  // Measurements (for alterations)
  currentMeasurements Json?
  desiredMeasurements String?

  // Pricing and status
  status        RepairStatus @default(PENDING)
  estimatedCost Float?
  actualCost    Float?
  depositPaid   Float?
  urgency       Boolean      @default(false)

  // Repair Details
  tailorNotes    String?
  materialsUsed  String[] // List of materials used(thread, zippers, buttons, etc.)
  completionTime Int? // Estimated completion time in days

  // Scheduling
  preferredPickupDate DateTime?
  estimatedReadyDate  DateTime?
  completedAt         DateTime?

  // Location
  pickupLocation   Address? @relation(fields: [pickupLocationId], references: [id])
  pickupLocationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([estimatedReadyDate])
}

model RepairService {
  id            String        @id @default(cuid())
  serviceName   String
  repairType    RepairType
  clothingType  ClothingType?
  fabricType    FabricType?
  description   String?
  baseCost      Float
  complexity    String? // SIMPLE, MODERATE, COMPLEX
  estimatedTime Int? // Estimated time in hours
  isActive      Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceName, repairType, clothingType])
}

// Review model
model Review {
  id        String   @id @default(cuid())
  rating    Int // Rating out of 5
  comment   String?
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
